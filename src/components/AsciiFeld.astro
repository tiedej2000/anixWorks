---
interface Props {
  spalten: number;
  zeilen: number;
  schriftgroesse: number;
  zeichen?: string;
}

const { spalten, zeilen, schriftgroesse, zeichen = '+' } = Astro.props;
const zeilenListe = Array.from({ length: zeilen });
const spaltenListe = Array.from({ length: spalten });
---

<div class="ascii" style={`font-size:${schriftgroesse}px;`}>
  {zeilenListe.map(() => (
    <div class="ascii-row">
      {spaltenListe.map(() => <span class="ascii-char">{zeichen}</span>)}
    </div>
  ))}
</div>

<style>
  .ascii {
    font-family: var(--schrift-mono);
    font-weight: 500;
    line-height: 1.45;
    color: var(--farbe-rand-stark);
    user-select: none;
  }

  .ascii-row {
    display: flex;
    justify-content: space-between;
  }
</style>
